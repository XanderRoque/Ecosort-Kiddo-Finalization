<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blur_background"
    tools:context=".ProfileActivity">

    <ImageView
        android:id="@+id/background_avatar"
        android:layout_width="270dp"
        android:layout_height="315dp"
        android:layout_marginStart="70dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="50dp"
        android:alpha="0.6"
        android:contentDescription="@string/imageView1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.986"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/profile_color_background" />

    <ImageView
        android:id="@+id/background_achievements"
        android:layout_width="270dp"
        android:layout_height="315dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="88dp"
        android:layout_marginBottom="50dp"
        android:alpha="0.6"
        android:contentDescription="@string/imageView2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/profile_color_background" />

    <TextView
        android:id="@+id/txt_avatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="110dp"
        android:fontFamily="@font/cubao_regular"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="3"
        android:text="Avatars"
        android:textColor="@color/white"
        android:textSize="33sp"
        app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
        app:layout_constraintEnd_toEndOf="@+id/background_avatar"
        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintStart_toStartOf="@+id/background_avatar"
        app:layout_constraintTop_toTopOf="@+id/background_avatar"
        app:layout_constraintVertical_bias="0.105" />

    <TextView
        android:id="@+id/txt_achievements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="50dp"
        android:layout_marginBottom="190dp"
        android:fontFamily="@font/cubao_regular"
        android:gravity="center_vertical"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="3"
        android:text="@string/achievements_text"
        android:textColor="@color/white"
        android:textSize="31sp"
        app:layout_constraintBottom_toBottomOf="@+id/background_achievements"
        app:layout_constraintEnd_toEndOf="@+id/background_achievements"
        app:layout_constraintHorizontal_bias="0.411"
        app:layout_constraintStart_toStartOf="@+id/background_achievements"
        app:layout_constraintTop_toTopOf="@+id/background_achievements"
        app:layout_constraintVertical_bias="0.179" />

    <ImageView
        android:id="@+id/background_name"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginStart="23dp"
        android:layout_marginTop="65dp"
        android:layout_marginEnd="90dp"
        android:layout_marginBottom="45dp"
        android:gravity="center_vertical"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/profile_nn_bg" />

    <FrameLayout
        android:layout_width="158dp"
        android:layout_height="200dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="73dp"
        android:layout_marginBottom="115dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.04"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.051">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/change_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/avatar_1"
            app:shapeAppearanceOverlay="@style/image_cornered_main"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <View
            android:layout_width="158dp"
            android:layout_height="200dp"
            android:background="@drawable/image_round" />
    </FrameLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/first_avatar"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="83dp"
        android:layout_marginBottom="86dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
        app:layout_constraintEnd_toEndOf="@+id/background_avatar"
        app:layout_constraintHorizontal_bias="0.187"
        app:layout_constraintStart_toStartOf="@+id/background_avatar"
        app:layout_constraintTop_toTopOf="@+id/background_avatar"
        app:layout_constraintVertical_bias="0.46"
        app:layout_editor_absoluteX="606dp"
        app:layout_editor_absoluteY="135dp"
        app:shapeAppearanceOverlay="@style/image_cornered"
        app:srcCompat="@drawable/avatar_1" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/second_avatar"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="90dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="86dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
        app:layout_constraintEnd_toEndOf="@+id/background_avatar"
        app:layout_constraintHorizontal_bias="0.789"
        app:layout_constraintStart_toStartOf="@+id/background_avatar"
        app:layout_constraintTop_toTopOf="@+id/background_avatar"
        app:layout_constraintVertical_bias="0.456"
        app:layout_editor_absoluteX="606dp"
        app:layout_editor_absoluteY="135dp"
        app:shapeAppearanceOverlay="@style/image_cornered"
        app:srcCompat="@drawable/avatar_two" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/third_avatar"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="90dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="14dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
        app:layout_constraintEnd_toEndOf="@+id/background_avatar"
        app:layout_constraintHorizontal_bias="0.794"
        app:layout_constraintStart_toStartOf="@+id/background_avatar"
        app:layout_constraintTop_toTopOf="@+id/background_avatar"
        app:layout_constraintVertical_bias="0.981"
        app:layout_editor_absoluteX="606dp"
        app:layout_editor_absoluteY="135dp"
        app:shapeAppearanceOverlay="@style/image_cornered"
        app:srcCompat="@drawable/avatar_three" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/fourth_avatar"
        android:layout_width="85dp"
        android:layout_height="115dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="80dp"
        android:layout_marginEnd="83dp"
        android:layout_marginBottom="14dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="@+id/background_avatar"
        app:layout_constraintEnd_toEndOf="@+id/background_avatar"
        app:layout_constraintHorizontal_bias="0.184"
        app:layout_constraintStart_toStartOf="@+id/background_avatar"
        app:layout_constraintTop_toTopOf="@+id/background_avatar"
        app:layout_constraintVertical_bias="0.98"
        app:layout_editor_absoluteX="606dp"
        app:layout_editor_absoluteY="135dp"
        app:shapeAppearanceOverlay="@style/image_cornered"
        app:srcCompat="@drawable/avatar_four" />

    <ImageView
        android:id="@+id/garbageGuru"
        android:layout_width="115dp"
        android:layout_height="116dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="70dp"
        android:layout_marginBottom="75dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_achievements"
        app:layout_constraintEnd_toEndOf="@+id/background_achievements"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@+id/background_achievements"
        app:layout_constraintTop_toTopOf="@+id/background_achievements"
        app:layout_constraintVertical_bias="0.406"
        app:srcCompat="@drawable/garbage_guru" />

    <ImageView
        android:id="@+id/trashTactician"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:layout_marginStart="75dp"
        android:layout_marginTop="33dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="67dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_achievements"
        app:layout_constraintEnd_toEndOf="@+id/background_achievements"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="@+id/background_achievements"
        app:layout_constraintTop_toTopOf="@+id/background_achievements"
        app:layout_constraintVertical_bias="0.344"
        app:srcCompat="@drawable/trash_tactician" />

    <ImageView
        android:id="@+id/ecoOrganizer"
        android:layout_width="115dp"
        android:layout_height="116dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="87dp"
        android:padding="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_achievements"
        app:layout_constraintEnd_toEndOf="@+id/background_achievements"
        app:layout_constraintHorizontal_bias="0.234"
        app:layout_constraintStart_toStartOf="@+id/background_achievements"
        app:layout_constraintTop_toTopOf="@+id/background_achievements"
        app:layout_constraintVertical_bias="0.898"
        app:srcCompat="@drawable/eco_organizer" />

    <ImageView
        android:id="@+id/eco_Master"
        android:layout_width="116dp"
        android:layout_height="116dp"
        android:layout_marginStart="96dp"
        android:layout_marginTop="100dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/background_achievements"
        app:layout_constraintEnd_toEndOf="@+id/background_achievements"
        app:layout_constraintHorizontal_bias="0.92"
        app:layout_constraintStart_toStartOf="@+id/background_achievements"
        app:layout_constraintTop_toTopOf="@+id/background_achievements"
        app:layout_constraintVertical_bias="0.942"
        app:srcCompat="@drawable/eco_master" />

    <ImageButton
        android:id="@+id/exit_button_location1"
        android:layout_width="@dimen/_35sdp"
        android:layout_height="@dimen/_35sdp"
        android:layout_marginStart="@dimen/_95sdp"
        android:layout_marginTop="@dimen/_2sdp"
        android:layout_marginEnd="@dimen/_4sdp"
        android:layout_marginBottom="@dimen/_119sdp"
        android:background="@color/transparent"
        android:padding="@dimen/_1sdp"
        android:scaleType="fitCenter"
        android:src="@drawable/exit"
        android:contentDescription="@string/exit_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.979"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.045" />

    <EditText
        android:id="@+id/profile_name"
        android:layout_width="150dp"
        android:layout_height="33dp"
        android:fontFamily="@font/cubao_regular"
        android:gravity="center"
        android:shadowColor="#000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:hint="Name"
        android:textSize="28dp"
        android:background="@color/transparent"
        app:layout_constraintBottom_toBottomOf="@+id/background_name"
        app:layout_constraintEnd_toEndOf="@+id/background_name"
        app:layout_constraintStart_toStartOf="@+id/background_name"
        app:layout_constraintTop_toTopOf="@+id/background_name"
        app:layout_constraintVertical_bias="0.44"
        app:layout_editor_absoluteX="327dp"
        app:layout_editor_absoluteY="90dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_View"
        android:layout_width="600dp"
        android:layout_height="330dp"
        android:layout_margin="20dp"
        android:gravity="center"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@color/Cardview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" >

            <TextView
                android:id="@+id/save_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="50dp"
                android:text="@string/saveChanges_text"
                android:textSize="43dp"
                android:gravity="center_horizontal"
                android:fontFamily="@font/cubao_regular"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <LinearLayout
                android:layout_width="450dp"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="-5dp"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" >

                <Button
                    android:id="@+id/btn_Save"
                    android:layout_width="160dp"
                    android:layout_height="90dp"
                    android:layout_marginEnd="30dp"
                    android:text="@string/save_text"
                    android:textSize="30dp"
                    android:fontFamily="@font/cubao_regular"
                    android:background="@drawable/profile_color_background"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <Button
                    android:id="@+id/btn_dontsave"
                    android:layout_width="190dp"
                    android:layout_height="90dp"
                    android:text="@string/dontSave_text"
                    android:textSize="30dp"
                    android:fontFamily="@font/cubao_regular"
                    android:background="@drawable/profile_color_background"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>