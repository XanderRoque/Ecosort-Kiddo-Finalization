        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/wood_ingame" >

            <TextView
                android:id="@+id/backyardBackCardView_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|center_vertical"
                android:layout_marginBottom="30dp"
                android:layout_marginTop="50dp"
                android:text="Would you like to return to the Levels?"
                android:textSize="30dp"
                android:gravity="center_horizontal"
                android:fontFamily="@font/cubao_regular"
                android:textColor="@color/white" />


            <LinearLayout
                android:layout_width="450dp"
                android:layout_height="105dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="-10dp"
                android:layout_marginLeft="50dp"
                android:layout_marginRight="50dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <Button
                    android:id="@+id/backyardButton_yes"
                    android:layout_width="180dp"
                    android:layout_height="60dp"
                    android:layout_marginEnd="30dp"
                    android:text="@string/yes_text"
                    android:textSize="36dp"
                    android:fontFamily="@font/cubao_regular"
                    android:background="@drawable/btn_rounded"
                    android:textColor="@color/white"/>

                <Button
                    android:id="@+id/backyardButton_no"
                    android:layout_width="180dp"
                    android:layout_height="60dp"
                    android:text="@string/no_text"
                    android:textSize="36dp"
                    android:fontFamily="@font/cubao_regular"
                    android:background="@drawable/btn_rounded_red"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

