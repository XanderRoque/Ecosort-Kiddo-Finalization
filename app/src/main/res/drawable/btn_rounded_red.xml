<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid color for the background -->
    <solid android:color="@color/btn_color_red"/>

    <!-- Rounded corners -->
    <corners android:radius="10dp"/>

    <!-- Optional padding -->
    <padding
        android:left="10dp"
        android:top="10dp"
        android:right="10dp"
        android:bottom="10dp"/>

    <!-- Optional stroke, for border -->
    <stroke
        android:width="2dp"
        android:color="#000000"/>
</shape>