    <androidx.cardview.widget.CardView
        android:id="@+id/cardView_questionnaire"
        android:layout_width="809dp"
        android:layout_height="394dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:scaleType="fitXY"
            android:orientation="vertical"
            android:background="@android:color/transparent">

            <!-- Question Container -->
            <androidx.cardview.widget.CardView
                android:id="@+id/questionCard"
                android:layout_width="240dp"
                android:layout_height="180dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/loc2game"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/questionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:fontFamily="@font/montserratmeduim"
                        android:gravity="center"
                        android:text="@string/question_text"
                        android:textColor="@android:color/white"
                        android:textSize="23sp" />

                    <ImageView
                        android:id="@+id/questionImage"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_marginTop="0dp"
                        android:scaleType="centerInside"
                        android:background="@android:color/transparent"
                        android:src="@drawable/trash16" />

                    <TextView
                        android:id="@+id/imageText"
                        android:layout_width="235dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="-5dp"
                        android:fontFamily="@font/montserratmeduim"
                        android:gravity="center"
                        android:text="Banana peel"
                        android:textColor="@android:color/white"
                        android:textSize="20sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Answer Buttons -->
            <LinearLayout
                android:id="@+id/answerOptions"
                android:layout_width="450dp"
                android:layout_height="160dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Biodegradable Option -->
                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="160dp"
                    android:layout_marginEnd="20dp">

                    <ImageButton
                        android:id="@+id/biodegradable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/loc2game"
                        android:contentDescription="Biodegradable"
                        android:padding="5dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/biodegradable" />

                    </FrameLayout>

                <!-- Non-Biodegradable Option -->
                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp">

                    <ImageButton
                        android:id="@+id/non_biodegradable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/loc2game"
                        android:contentDescription="Non-Biodegradable"
                        android:padding="5dp"
                        android:paddingTop="30dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/non_biodegradable" />

                    </FrameLayout>

                <!-- Recyclable Option -->
                <FrameLayout
                    android:layout_width="130dp"
                    android:layout_height="160dp"
                    android:layout_marginStart="20dp">

                    <ImageButton
                        android:id="@+id/recyclable"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/loc2game"
                        android:contentDescription="Recyclable"
                        android:padding="5dp"
                        android:paddingTop="10dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/recyclable" />

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

